{
  "description": "Save local prompts and final answers across projects, isolated by session ID. No model calls.",
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{
      "type": "command",
      "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'dist', 'capture.cjs'))\"",
      "commandWindows": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'dist', 'capture.cjs'))\"",
      "timeout": 5
    }] }],
    "Stop": [{ "hooks": [{
      "type": "command",
      "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'dist', 'capture.cjs'))\"",
      "commandWindows": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'dist', 'capture.cjs'))\"",
      "timeout": 5
    }] }],
    "Interrupt": [{ "hooks": [{
      "type": "command",
      "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'dist', 'capture.cjs'))\"",
      "commandWindows": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'dist', 'capture.cjs'))\"",
      "timeout": 3
    }] }]
  }
}
